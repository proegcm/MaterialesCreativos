        function editarUsuario(user) {
            document.getElementById("idUsuarioMod").value = user.id_usuario;
            document.getElementById('nombre').value = user.nombre || '';
            document.getElementById('telefono').value = user.telefono || '';
            document.getElementById('username').value = user.username || ''; 
            document.getElementById('password').value = user.password || '';
            document.getElementById('activo').value = user.activo;

            // Seleccionar el rol del usuario
            const rolSelect = document.getElementById('roluser');
            const opciones = rolSelect.options;
            for (let i = 0; i < opciones.length; i++) {
                if (opciones[i].text === user.rol) {
                    rolSelect.selectedIndex = i; // Selecciona el rol por su texto
                    break;
                }
            }
            // Mostrar el formulario
            document.getElementById('formularioAgregarUsuario').style.display = 'block';
            document.getElementById('btnGuardarUsuario').style.display = 'none';
            document.getElementById('btnModUsuario').style.display = 'block';
            // Desplaza la vista al formulario
            document.getElementById('formularioAgregarUsuario').scrollIntoView({
                behavior: 'smooth',
                block: 'start'
            });

        }


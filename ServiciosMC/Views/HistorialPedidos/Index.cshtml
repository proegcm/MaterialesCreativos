<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
   <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Urbanist:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">

    <link href="~/css/estilosHistorial.css" rel="stylesheet">
    @* <link href="~/DataTables/datatables.min.css" rel="stylesheet">
    <script src="~/DataTables/datatables.min.js"></script> *@
    <title>Listado de Pedidos</title>
    <style>
    </style>
</head>
<body>
    <div class="row justify-content-center">
        <div class="col-12">
            <div class="row h-100">
                <div class="card historial-card mb-3">
                    <div class="card-body">
                        <div class="row">
                            <div class="d-flex align-items-center">
                                <span class="material-symbols-outlined card-icon">history</span>
                                <h3 class="card-title ml-2">HISTORIAL DE PEDIDOS</h3>
                            </div>
                        </div>
                        <!-- FORMULARIO DE FILTROS DE BÚSQUEDA -->
                        <div class="row mb-3 align-items-end">
                            <!-- Usuario -->
                            <div class="col-md-3 mb-2">
                                <label for="usuario" class="form-label">Usuario:</label>
                                <select id="usuario" class="form-select">
                                    <option selected>Seleccione un usuario</option>
                                    <!-- Opciones de usuario -->
                                </select>
                            </div>

                            <!-- Fecha inicio -->
                            <div class="col-md-2 mb-2">
                                <label for="fecha-inicio" class="form-label">Fecha inicio:</label>
                                <input type="date" id="fecha-inicio" class="form-control">
                            </div>

                            <!-- Fecha final -->
                            <div class="col-md-2 mb-2">
                                <label for="fecha-final" class="form-label">Fecha final:</label>
                                <input type="date" id="fecha-final" class="form-control">
                            </div>

                            <!-- Estado -->
                            <div class="col-md-3 mb-2">
                                <label for="estado" class="form-label">Estado:</label>
                                <select id="estado" class="form-select">
                                    <option selected>Seleccione un estado</option>
                                    <!-- Opciones de estado -->
                                </select>
                            </div>

                            <!-- Botón de búsqueda -->
                            <div class="col-md-2 mb-2">
                                <button type="button" class="btn btn-primary w-100" id="btnBuscar">
                                    <span class="material-symbols-outlined">search</span> Buscar
                                </button>
                            </div>
                        </div>

                        <div class="row">
                            <div class="table-responsive">
                                <table id="tabla-pedidos" class="table" style="width:100%">
                                    <thead>
                                        <tr>
                                            <th class="text-center">No.Folio</th>
                                            <th class="text-center">Cliente</th> 
                                            <th class="text-center">Usuario a cargo</th>
                                            <th class="text-center">Fecha pedido</th>
                                            <th class="text-center">Estado</th> 
                                        </tr>
                                    </thead>
                                    <tbody id="tbody-pedidos">
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</body>
</html>

<script type="text/javascript">

    $(document).ready(function () {
        let tablaPedidos = $('#tabla-pedidos').DataTable({
            "destroy": true,
            "ordering": false,
            "responsive": true,
            "bLengthChange": false,
            "language": {
                "url": "//cdn.datatables.net/plug-ins/1.10.15/i18n/Spanish.json"
            },
            "columnDefs": [
                { "width": "20%", "targets": 0 }, // Ancho de la columna 1 (No.Folio)
                { "width": "30%", "targets": 1 }, // Ancho de la columna 2 (Cliente)
                { "width": "10%", "targets": 2 }, // Ancho de la columna 3 (Usuario a cargo)
                { "width": "20%", "targets": 3 }, // Ancho de la columna 4 (Fecha pedido)
                { "width": "20%", "targets": 4 }  // Ancho de la columna 5 (Estado)
            ]
        });
        getUsuarios();
        getEstados();
         $('#btnBuscar').on('click', function () {
            llenarTabla();
         });

    // Obtener los elementos de fecha
    const fechaInicio = document.getElementById('fecha-inicio');
    const fechaFinal = document.getElementById('fecha-final');

    // Agregar evento para validar en tiempo real cuando cambia la fecha final
    fechaFinal.addEventListener('input', validarFechas);

    function validarFechas() {
        // Obtener los valores de las fechas seleccionadas
        const inicio = new Date(fechaInicio.value);
        const final = new Date(fechaFinal.value);

        // Comprobar que ambos campos de fecha tengan valor
        if (fechaInicio.value && fechaFinal.value) {
            // Calcular la diferencia en milisegundos
            const diferenciaTiempo = final.getTime() - inicio.getTime();
            // Convertir la diferencia en días
            const diferenciaDias = diferenciaTiempo / (1000 * 3600 * 24);

            // Validar si la diferencia es mayor a 30 días
            if (diferenciaDias > 30) {
                alert("La fecha final no puede ser más de un mes después de la fecha inicial.");
                // Limpiar la fecha final para que el usuario la seleccione nuevamente
                fechaFinal.value = '';
            }
        }
    }



    function consultaPedidos() {
        return new Promise((resolve, reject) => {
            document.getElementById('contenedor-loader').style.display = 'flex';

            $.ajax({
                url: '@Url.Action("ListaPedidos", "HistorialPedidos")',
                type: "POST",
                success: function (data) {
                    if (!data.success) {
                        console.log(data.errorMensaje);
                        dialogoEG({
                            type: "error",
                            title: "Error consulta de pedidos",
                            mensaje: data.errorMensaje,
                            confirmar: "Aceptar",
                            img: "img/error.png"
                        }).then(() => {
                            tablaPedidos.clear().draw();
                        });

                        // Rechazar la promesa si hay un error en la respuesta
                        reject(new Error(data.errorMensaje));
                    } else {
                        // Parsear la cadena 'respuesta' a un objeto JSON
                        const respuestaObj = JSON.parse(data.respuesta);

                        // Obtener el listado de pedidos
                        const listadoPedidos = respuestaObj.listadoPedidos;

                        resolve(listadoPedidos); 

                    }
                    document.getElementById('contenedor-loader').style.display = 'none';
                },
                error: function (xhr, status, error) {
                    document.getElementById('contenedor-loader').style.display = 'none';
                    dialogoEG({
                        type: "error",
                        title: "Error de comunicación",
                        mensaje: "Ocurrió un error al obtener listado de pedidos. Intente nuevamente, si el inconveniente persiste contacte al administrador.",
                        confirmar: "Aceptar",
                        img: "img/error.png"
                    });
                    // Rechazar la promesa en caso de error
                    reject(error);
                }
            });
        });
    }

    function llenarTabla() {
        // Limpia la tabla antes de llenarla
        tablaPedidos.clear().draw();

        consultaPedidos().then(listadoPedidos => {
        listadoPedidos.forEach(pedido => {
            // Agrega los datos del pedido a la tabla
            let row = tablaPedidos.row.add([
                pedido.folio,
                pedido.cliente,
                pedido.usuario_registro,
                pedido.fecha,
                `<div class="contenedor-acciones">
                    <button class="btn btn-sm btn-acciones btn-tracking" title="Ver Tracking">
                        <span class="material-symbols-outlined">wysiwyg</span>
                        ${pedido.estado_actual}
                    </button>
                </div>`
            ]).draw().node();

            // Seleccionar el botón de seguimiento
            let botonTracking = row.querySelector('.btn-tracking');
            botonTracking.addEventListener('click', function () {
                verTracking(pedido); 
            });
        });
    });

    }



// Consulta de usuarios para el select del formulario
function getUsuarios() {
    document.getElementById('contenedor-loader').style.display = 'flex';
    $.ajax({
        url: '@Url.Action("ConsultaUsuarios", "PanelControl")',
        type: "POST",
        success: function (data) {
            if (!data.success) {
                console.log(data.errorMensaje);
            } else {
                // Deserializar la respuesta JSON
                let respuesta = JSON.parse(data.respuesta);

                // Acceder al array de usuarios
                let listadoUsuarios = respuesta.listadoUsuarios;

                // Obtener el elemento select
                let userSelect = $('#usuario');
                // Vaciar las opciones existentes
                userSelect.empty();
                // Agregar la opción predeterminada
                userSelect.append('<option value="">Selecciona un usuario</option>');

                // Agregar los usuarios al select
                listadoUsuarios.forEach(usr => {
                    userSelect.append(`<option value="${usr.id_usuario}">${usr.username}</option>`);
                });
            }
            document.getElementById('contenedor-loader').style.display = 'none';
        },
        error: function (xhr, status, error) {
            document.getElementById('contenedor-loader').style.display = 'none';
            dialogoEG({
                type: "error",
                title: "Error de comunicación",
                mensaje: "Ocurrió un error al obtener el listado de usuarios. Intente nuevamente; si el inconveniente persiste, solicite soporte.",
                confirmar: "Aceptar",
                img: "img/error.png"
            });
        }
    });
}

    function getEstados(){
        // Lista de estados únicos
        const estados = [
            "TODOS",
            "En producción",
            "Completado",
            "Envío por Mensajería",
            "Envío por Paquetería",
            "Recoge en oficina",
            "Anulado",
            "Devuelto",
            "Reprogramar",
            "Entregado"
        ];

        // Obtener el elemento select
        const selectEstado = document.getElementById('estado');

        // Llenar el select con los estados
        estados.forEach(estado => {
            let option = document.createElement('option');
            option.value = estado;
            option.textContent = estado;
            selectEstado.appendChild(option);
        });
    }


    function verTracking(pedido) {
    // Imprimir información básica del pedido
    console.log(`Folio: ${pedido.folio}`);
    console.log(`Fecha: ${pedido.fecha}`);
    console.log(`Cajero: ${pedido.cajero}`);
    console.log(`Cliente: ${pedido.cliente}`);
    console.log(`Total: ${pedido.total}`);
    console.log(`Pago: ${pedido.pago}`);
    console.log(`Cambio: ${pedido.cambio}`);
    console.log(`Estado actual: ${pedido.estado_actual}`);
    console.log(`Usuario registro: ${pedido.usuario_registro}`);

    // Recorrer e imprimir cada tracking asociado al pedido
    if (pedido.tracking) { // Verifica que tracking no sea undefined
        pedido.tracking.forEach(tracking => {
            console.log(`--- Tracking ${pedido.folio} ---`);
            console.log(`   Estado: ${tracking.estado}`);
            console.log(`   Fecha estado: ${tracking.fecha_estado}`);
            console.log(`   Usuario cambio: ${tracking.usuario_cambio}`);
            console.log(`   Mensajero: ${tracking.mensajero}`);
            console.log(`   Paquetería: ${tracking.paqueteria}`);
            console.log(`   Observaciones: ${tracking.observaciones}`);
        });
    }
}

    });

</script>
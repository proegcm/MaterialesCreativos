<script type="text/javascript">

    $(document).ready(function () {
        let tablaPedidos = $('#tabla-pedidos').DataTable({
            "destroy": true,
            "ordering": false,
            "responsive": true,
            "bLengthChange": false,
            "language": {
                "url": "//cdn.datatables.net/plug-ins/1.10.15/i18n/Spanish.json"
            },
            "columnDefs": [
                { "width": "20%", "targets": 0 }, // Ancho de la columna 1 (No.Folio)
                { "width": "30%", "targets": 1 }, // Ancho de la columna 2 (Cliente)
                { "width": "10%", "targets": 2 }, // Ancho de la columna 3 (Usuario a cargo)
                { "width": "20%", "targets": 3 }, // Ancho de la columna 4 (Fecha pedido)
                { "width": "20%", "targets": 4 }  // Ancho de la columna 5 (Estado)
            ]
        });
        getUsuarios();
        getEstados();
         $('#btnBuscar').on('click', function () {
            llenarTabla();
         });

         $('#fecha-inicio').on('change', cambioFechaInicio);
         $('#fecha-final').on('change', cambioFechaFin);

         function cambioFechaInicio(e) {
                e.preventDefault();
                const fechaInicio = e.target.value;
                const fechaFin = $('#fecha-final').val();
                if (fechaFin === "") {
                    return;
                }
                validarFechas(fechaInicio, fechaFin);
            }


            function cambioFechaFin(e) {
                e.preventDefault();
                const fechaFin = e.target.value;
                const fechaInicio = $('#fecha-inicio').val();
                if (fechaInicio === "") {
                    return;
                }
                validarFechas(fechaInicio,fechaFin);

            }

            const validarFechas = (StrFechaInicio, StrFechaFin) => {
                const dateFechaInicio = toDate(StrFechaInicio);
                const dateFechaFin = toDate(StrFechaFin);

                if (diffDays(dateFechaInicio, dateFechaFin) > 31) {
                    toastr.warning('El rango de la fecha no debe exceder 31 días');
                    return false;
                }

                if (dateFechaInicio > dateFechaFin) {
                    toastr.warning('La fecha de inicio debe ser menor o igual a la fecha de fin');
                    return false;
                }
                return true;
            }

    function consultaPedidos() {
        return new Promise((resolve, reject) => {
            let parametros = obtenerParametros();
            document.getElementById('contenedor-loader').style.display = 'flex';

            $.ajax({
                url: '@Url.Action("ListaPedidos", "HistorialPedidos")',
                type: "POST",
                data: parametros,
                success: function (data) {
                    if (!data.success) {
                        dialogoEG({
                            type: "error",
                            title: "Error consulta de pedidos",
                            mensaje: data.errorMensaje,
                            confirmar: "Aceptar",
                            img: "img/error.png"
                        }).then(() => {
                            tablaPedidos.clear().draw();
                        });

                        // Rechazar la promesa si hay un error en la respuesta
                        reject(new Error(data.errorMensaje));
                    } else {
                        // Parsear la cadena 'respuesta' a un objeto JSON
                        const respuestaObj = JSON.parse(data.respuesta);

                        // Obtener el listado de pedidos
                        const listadoPedidos = respuestaObj.listadoPedidos;
                        const pdf = respuestaObj.pdf_base64;
                        
                        // Mostramos el botón si el PDF está disponible                        
                        if (pdf) {
                            document.getElementById('btnReportePDF').style.display = 'block';

                            // Agregar un evento click al botón
                            document.getElementById('btnReportePDF').onclick = function(event) {
                                event.preventDefault(); // Prevenir la acción por defecto del enlace
        
                                // Crear un elemento de enlace temporal
                                const downloadLink = document.createElement('a');
                                downloadLink.href = "data:application/pdf;base64,"+pdf; 
                                downloadLink.download = 'reporte.pdf'; // Nombre del archivo al descargar
        
                                // Agregar el enlace al DOM (aunque no es necesario mostrarlo)
                                document.body.appendChild(downloadLink);
        
                                // Hacer clic en el enlace para iniciar la descarga
                                downloadLink.click();
        
                                // Eliminar el enlace temporal del DOM
                                document.body.removeChild(downloadLink);
                            };
                        }

                        resolve(listadoPedidos); 

                    }
                    document.getElementById('contenedor-loader').style.display = 'none';
                },
                error: function (xhr, status, error) {
                    document.getElementById('contenedor-loader').style.display = 'none';
                    dialogoEG({
                        type: "error",
                        title: "Error de comunicación",
                        mensaje: "Ocurrió un error al obtener listado de pedidos. Intente nuevamente, si el inconveniente persiste contacte al administrador.",
                        confirmar: "Aceptar",
                        img: "img/error.png"
                    });
                    // Rechazar la promesa en caso de error
                    reject(error);
                }
            });
        });
    }

    function obtenerParametros() {
        return {
            usuarioConsulta: "",
            usuario: $('#usuario option:selected').val(),
            fechaInicio: $('#fecha-inicio').val(),
            fechaFin: $('#fecha-final').val(),
            estado : $('#estado option:selected').val()
        };
    }

    function llenarTabla() {
        tablaPedidos.clear().draw();

        consultaPedidos().then(listadoPedidos => {
        listadoPedidos.forEach(pedido => {
            let row = tablaPedidos.row.add([
                pedido.folio,
                pedido.cliente,
                pedido.usuario_registro,
                pedido.fecha,
                `<div class="contenedor-acciones">
                    <button class="btn btn-sm btn-acciones btn-tracking" title="Ver Tracking">
                        <span class="material-symbols-outlined">wysiwyg</span>
                        ${pedido.estado_actual}
                    </button>
                </div>`
            ]).draw().node();

            let botonTracking = row.querySelector('.btn-tracking');
            botonTracking.addEventListener('click', function () {
                verTracking(pedido); 
            });
        });
    });

    }



// Consulta de usuarios para el select del formulario
function getUsuarios() {
    document.getElementById('contenedor-loader').style.display = 'flex';
    $.ajax({
        url: '@Url.Action("ConsultaUsuarios", "HistorialPedidos")',
        type: "POST",
        success: function (data) {
            if (data.success) {
                // Acceder al array de usuarios
                let listadoUsuarios = data.listadoUsuarios;

                // Obtener el elemento select
                let userSelect = $('#usuario');
                // Vaciar las opciones existentes
                userSelect.empty();
                // Agregar la opción predeterminada
                userSelect.append('<option value="">Selecciona un usuario</option>');

                // Agregar los usuarios al select
                listadoUsuarios.forEach(usr => {
                    userSelect.append(`<option value="${usr.id_usuario}">${usr.username} - ${usr.nombre}</option>`);
                });

                //Seleccionar el usuario en caso de 
            }
            document.getElementById('contenedor-loader').style.display = 'none';
        },
        error: function (xhr, status, error) {
            document.getElementById('contenedor-loader').style.display = 'none';
            dialogoEG({
                type: "error",
                title: "Error de comunicación",
                mensaje: "Ocurrió un error al obtener el listado de usuarios. Intente nuevamente; si el inconveniente persiste, solicite soporte.",
                confirmar: "Aceptar",
                img: "img/error.png"
            });
        }
    });
}


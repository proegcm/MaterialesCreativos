                            </div>
                        </div>
                        <div class="row">
                            <div>
                                <a href="#" target="_blank" class="btn btn-danger mt-lg-4 mt-md-4 float-sm-right float-md-left float-lg-left mr-lg-1 mr-md-1" style="display:none" id="btnReportePDF">
                                    Generar reporte pdf

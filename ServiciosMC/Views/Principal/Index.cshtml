                function combinarObservaciones(pedidoObservaciones, obvs) {
                    // Verificar y combinar las observaciones según las condiciones
                    if (pedidoObservaciones && obvs) {
                        return pedidoObservaciones + " / " + obvs;
                    } else if (!pedidoObservaciones && obvs) {
                        return obvs;
                    } else if (pedidoObservaciones && !obvs) {
                        return pedidoObservaciones;
                    }
                    return ''; // En caso de que ambos estén vacíos
                }

                //Obtener estados siguientes posibles
                function getNextStates(currentState) {
                    // console.log("Dentro de getNextStates: " + currentState);
                    const stateTransitions = {
                        production: [

        </div>
     
   <!--Dialogo clientes-->
   <div class="modal fade" id="dialogBusquedaClientes" tabindex="-1" aria-labelledby="dlgBCli" aria-hidden="true">
	        <div class="modal-dialog modal-dialog-centered modal-sm">
		        <div class="modal-content">
			        <div class="modal-header">
				        <h5 class="modal-title" id="dlgBCli">Buscar clientes</h5>
				        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">
					        <span aria-hidden="true">&times;</span>
				        </button>
			        </div>
			        <div class="modal-body">
                    <input type="text" id="filterInput" class="form-control mb-3" placeholder="Filtrar clientes...">
				        <div id="listaClientes" class="list-group cliente-scroll-container"></div>
			        </div>
			        <div class="modal-footer">
				        <!--mostrar cantidad de clientes-->
			        </div>
		        </div>
	        </div>
        </div>

    <script type="text/javascript">
        let parametros = "";
        let usuarioLogin = "";
        let pilotosActivos = [];
        let modalInstance;

        const categoryMap = {
            "En producción": "production",
            "Envío por Mensajería": "courier",
            "Envío por Paquetería": "parcel",
            "Entregado": "delivered",
            "Devuelto": "returned",
            "Anulado": "canceled",
            "Completado": "completed",
            "Recoge en oficina": "pickup",
            "Reprogramar": "rescheduled"
        };

        const entospa = {
            "production": "En producción",
            "courier": "Envío por Mensajería",
            "parcel": "Envío por Paquetería",
            "delivered": "Entregado",
            "returned": "Devuelto",
            "canceled": "Anulado",
            "completed": "Completado",
            "pickup": "Recoge en oficina",
            "rescheduled": "Reprogramar"

        };

        $(document).ready(function(){
            $('[data-toggle="tooltip"]').tooltip();

            consultaPedidos();
            cargaClientes();

            function mostrarCampos() {
                let tipoBusqueda = document.getElementById("tipoBusqueda").value;
                document.getElementById("busquedaFolio").classList.toggle("d-none", tipoBusqueda !== "folio");
                document.getElementById("busquedaCliente").classList.toggle("d-none", tipoBusqueda !== "cliente");
            }
            // Detectar atajos de teclado
            document.addEventListener("keydown", function(event) {
                if (event.ctrlKey && event.key === "c") {
                    event.preventDefault();
                    document.getElementById("tipoBusqueda").value = "cliente";
                    mostrarCampos();
                }
                if (event.ctrlKey && event.key === "f") {
                    event.preventDefault();
                    document.getElementById("tipoBusqueda").value = "folio";
                    mostrarCampos();
                }
                if (event.ctrlKey && event.key === "l") {
                    event.preventDefault();
                    limpiar();
                }
                if (event.ctrlKey && event.key === "a") {
                    event.preventDefault();
                    $('#dialogBusquedaClientes').modal('show');
                }
                if (event.key === "Enter") {
                    event.preventDefault(); // Prevenir el comportamiento por defecto del Enter
                    let tipoBusqueda = $("#tipoBusqueda").val();
                    if (tipoBusqueda === "folio") {
                        buscarTicketFolio();
                    } else {
                        buscarTicketCliente();
                    }
                }
            });


            let dialogBusquedaClientes = document.getElementById('dialogBusquedaClientes');

                    $('#dialogBusquedaClientes').on('shown.bs.modal', function () {
                $('#filterInput').focus();
            });

            document.getElementById("btnReintentarCarga").addEventListener("click", function () {
              this.setAttribute("disabled", true);
              cargaClientes();
            });

             $("#txtFolio").on("input", function () {
                this.value = this.value.replace(/[^0-9]/g, '');
            });

            $(".soloNumeros").keypress(function (e) {
                if (e.which != 8 && e.which != 0 && (e.which < 48 || e.which > 57)) {
                    return false;
                }
            });
            
            $("#btnMostrarClientes").on('click', function() {
                $('#dialogBusquedaClientes').modal('show');
            });

            function cargaClientes(){
                $("#btnMostrarClientes i").removeClass('fas fa-users').addClass('fas fa-spinner fa-spin');
                $.ajax({
                    url: '@Url.Action("ObtenerClientes", "Principal")',
                    type: "POST",
                    success: function (data) {
                        const btnMostrarClientes = document.getElementById("btnMostrarClientes");
                        const btnReintentar = document.getElementById("btnReintentarCarga");
                        if (data.existeError) {
                            console.log("Error al cargar clientes");
                            btnMostrarClientes.setAttribute("disabled", true);
                            btnReintentar.removeAttribute("disabled");
                        } else {
                            if (data.existenDatos) {
                                const clientes = data?.infoClientes?.listaClientes || [];
                                clientes.forEach((item)=> {
                                    const lista = document.getElementById('listaClientes');

                                });

                                btnMostrarClientes.removeAttribute("disabled");
                                btnReintentar.setAttribute("disabled", true);
                                btnReintentar.classList.add("d-none");
                            } else {
                                btnMostrarClientes.setAttribute("disabled", true);
                                btnReintentar.removeAttribute("disabled");
                                btnReintentar.classList.remove("d-none");
                            }
                            $("#btnMostrarClientes i").removeClass('fas fa-spinner fa-spin').addClass('fas fa-users');
                        }
                    },
                        error: function () {
                            console.log("Error en la petición AJAX.");
                            document.getElementById("btnReintentarCarga").removeAttribute("disabled");
                        }
                    });
            }
        });

// Fuera de ready --------------------------------------------------------------------------------
                //Consulta folio en firebird
                function buscarTicketFolio() {
                    $('#pedidoInfo').hide();
                    let input = $('#txtFolio');
                    let nofolio = $('#txtFolio').val().trim();

                    input.tooltip('dispose');

                    if (nofolio === '') {
                        // Agregar tooltip con el mensaje de error
                        input.attr('data-bs-toggle', 'tooltip')
                             .attr('data-bs-placement', 'bottom')
                             .attr('title', 'Debes ingresar un número de folio.')
                             .tooltip('show');

                        // Ocultar el tooltip después de 5 segundos y eliminarlo

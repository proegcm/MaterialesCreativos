                                                </button>
                                                <button type="button" class="btn" id="btnLimpiarCliente" title="Limpiar búsqueda" onclick="limpiar()">
                                                    <span class="material-symbols-outlined">backspace</span>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- Buscar por Número de Folio (inicia oculto) -->

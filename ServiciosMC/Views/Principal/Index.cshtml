<!DOCTYPE html>
<html lang="es">
<head>
	<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet" />
	<link href="https://fonts.googleapis.com/css2?family=Urbanist:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
	<link href="~/css/estilosHome.css" rel="stylesheet">
	<style>
		.highlight {
			background-color: #f0f0f0;
		}
	</style>
</head>
<body>
    <div class="row justify-content-center">
        <div class="col-sm-12 col-lg-10 col-md-10 ">
            <div class="row h-100">
                <div class="col-sm-4 col-md-6 col-lg-5 flex-grow-1 custom-stack">
                    <!--DIV IZQUIERDA-->
                    <div class="card ticket-card" style="margin-top: 3px;">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-12">
                                    <div class="form-group d-flex align-items-center">
                                        <span class="material-symbols-outlined card-icon">
                                            order_approve
                                        </span>
                                        <h3 class="card-title ml-2">BUSCAR TICKET</h3>
                                    </div>
                                </div>
                                <div class="col-12 mb-2">
                                    <div class="form-group">
                                        <div class="input-group">
                                            <label for="tipoBusqueda">Buscar por:</label>
                                            <select class="form-select ml-2" id="tipoBusqueda" onchange="mostrarCampos()">
                                                <option value="cliente">Nombre del cliente</option>
                                                <option value="folio">Número de folio</option>
                                            </select>
                                            <span class="tooltip-icon ml-2" data-toggle="tooltip" title="Usa Ctrl + F para buscar por folio o Ctrl + C para buscar por cliente">
                                                <i class="fas fa-question-circle"></i>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                                <div id="buscarTicketForm" class="col-12">
                                    <!-- Buscar por Cliente y Fecha (inicia visible) -->
                                    <div id="busquedaCliente">
                                        <div class="form-group mb-2">
                                            <div class="input-group">
                                                <label for="txtCliente" class="me-2">Cliente:</label>
                                                <input type="text" class="form-control" placeholder="Ingrese nombre del cliente" id="txtCliente" autofocus>
                                                <button type="button" class="btn btn-icon" id="btnMostrarClientes" data-toggle="tooltip" title="Usa Ctrl + A para mostrar los clientes" disabled>
                                                    <i class="fas fa-users"></i>
                                                </button>
                                                <button type="button" class="btn btn-icon d-none" id="btnReintentarCarga" title="Intentar cargar clientes de nuevo" disabled>
                                                    <i class="fas fa-redo"></i>
                                                </button>
                                            </div>
                                        </div>
                                        <div class="form-group mb-3">
                                            <div class="input-group">
                                                <label for="txtFecha" class="me-2">Fecha:</label>
                                                <input type="date" class="form-control" id="txtFecha" min="2000-01-01">
                                                <button type="button" class="btn ml-2" title="Buscar pedido" id="btnBuscarTicketCliente" onclick="buscarTicketCliente()">
                                                    <span class="material-symbols-outlined">search</span>
                                                </button>
                                                <button type="button" class="btn" id="btnLimpiarCliente" title="Limpiar búsqueda" onclick="limpiar()">
                                                    <span class="material-symbols-outlined">backspace</span>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- Buscar por Número de Folio (inicia oculto) -->
                                    <div class="d-none" id="busquedaFolio">
                                        <div class="form-group mb-2">
                                            <div class="input-group">
                                                <label for="txtFolio" class="me-2">Folio:</label>
                                                <input type="text" class="form-control" placeholder="Ingrese número de folio"
                                                       name="txtFolio" id="txtFolio" maxlength="10" inputmode="numeric" />
                                                <button type="button" class="btn btn-icon" title="Buscar ticket" id="btnBuscarTicket" onclick="buscarTicketFolio()">
                                                    <span class="material-symbols-outlined">search</span>
                                                </button>
                                                <button type="button" class="btn btn-icon" id="btnLimpiar" title="Limpiar búsqueda" onclick="limpiar()">
                                                    <span class="material-symbols-outlined">backspace</span>
                                                </button>
                                            </div>
                                        </div>
                                    </div>

                                </div>

                            </div>
                        </div>
                    </div>
                   
                    <!--DIV PEDIDO-->
                    <div class="card infopedido-card" style="margin-top: 3px; display: none;" id="pedidoInfo">
                        <div class="card-body">
                            <div class="row">
                                <!-- Título -->
                                <div class="col-12">
                                    <div class="form-group d-flex align-items-center">
                                        <h3 class="card-title">INFORMACIÓN DEL PEDIDO</h3>
                                    </div>
                                </div>

                                <!-- Información del Cliente y Pedidos -->
                                <div class="col-12">
                                    <div class="form-group d-flex flex-column align-items-start justify-content-end">
                                        <!-- Cliente, Folio, Fecha, Cajero -->
                                        <p><strong>Cliente:</strong> <span id="cliente"></span></p>
                                        <p><strong>Folio:</strong> <span id="folio"></span></p>
                                        <p><strong>Fecha:</strong> <span id="fecha"></span></p>
                                        <p><strong>Cajero:</strong> <span id="cajero"></span></p>
                                    </div>
                                </div>

                                <!-- Detalle del Pedido -->
                                <div class="col-12">
                                    <div class="table-responsive">
                                        <table class="table table-sm">
                                            <thead class="table-light">
                                                <tr>
                                                    <th class="cantidad-col">Cant.</th>
                                                    <th>Producto</th>
                                                    <th>Precio</th>
                                                    <th class="text-end">Subtotal</th>
                                                </tr>
                                            </thead>
                                            <tbody id="detallePedido">
                                                <!-- Los productos se agregarán aquí -->
                                            </tbody>
                                        </table>
                                    </div>
                                </div>

                                <!-- Totales -->
                                <div class="col-12">
                                    <div class="d-flex justify-content-between">
                                        <p class="mb-0"><strong>Total:</strong></p>
                                        <p class="mb-0 totales">Q<span id="total"></span></p>
                                    </div>
                                    <div class="d-flex justify-content-between">
                                        <p class="mb-0"><strong>Pago:</strong></p>
                                        <p class="mb-0 totales">Q<span id="pago"></span></p>
                                    </div>
                                    <div class="d-flex justify-content-between">
                                        <p class="mb-0"><strong>Cambio:</strong></p>
                                        <p class="mb-0 totales">Q<span id="cambio"></span></p>
                                    </div>
                                </div>

                                <!-- Botón para pasar a producción -->
                                <div class="col-12 mt-2">
                                    <button class="btn btn-block w-100" style="background-color: #e86217; color: #ffffff;" id="btnPasarProduccion" onclick="ingresaTicket()">
                                        <i class="fas fa-share" style="margin-right: 6px; vertical-align: middle;"></i> Pasar a producción
                                    </button>
                                </div>

                                <!--Botón asociar pedido-->
                                <div class="col-12 mt-2">
                                    <button class="btn btn-secondary btn-block w-100" type="button" id="btnEnlaceAsociar" data-bs-toggle="collapse" data-bs-target="#collapseAsociarPedido" aria-expanded="false" aria-controls="collapseAsociarPedido">
                                        <i class="fas fa-link" style="margin-right: 6px; vertical-align: middle;"></i> Asociar a otro pedido
                                    </button>
                                </div>

                                <!-- Collapse con input y botón -->
                                <div class="col-12 collapse mt-2" id="collapseAsociarPedido">
                                    <div class="card card-body">
                                        <div class="input-group">
                                            <input type="number" class="form-control" id="txtAsociar" placeholder="Folio del pedido a asociar">
                                            <button class="btn btn-success" type="button" onclick="asociarPedido()">
                                                <i class="fas fa-check"></i> Asociar
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
               
                </div>
                <div class="col-sm-8 col-md-6 col-lg-7 flex-grow-1 custom-stack">
                    <!--DIV DERECHA-->
                        <div class="card pedidos-card" style="margin-top: 3px">
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-12 cpedidos">
                                        <div class="form-group d-flex justify-content-center align-items-center">
                                            <span class="material-symbols-outlined card-icon">package_2</span>
                                            <h3 class="card-title ml-2">PEDIDOS</h3>
                                        </div>
                                    </div>
                                    <div class="col-12 text-center sin-registros">
                                        <span class="material-symbols-outlined" >info</span>
                                        <h5 class="mt-2" style="color: gray;">Sin registros</h5>
                                    </div>
                                    <div class="col-12  oculto">
                                        <div class="form-group order-category category-1">
                                            <div class="order-header">
                                                <span class="material-symbols-outlined order-icon">arrow_drop_down_circle</span>
                                                <h3 class="order-icon">En Producción</h3>
                                            </div>
                                            <div class="card-container" id="production-orders">
                                                <!-- Listado de pedidos en producción -->
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-12 oculto">
                                        <div class="form-group order-category category-2">
                                            <div class="order-header">
                                                <span class="material-symbols-outlined order-icon">arrow_drop_down_circle</span>
                                                <h3 class="order-icon">Completado</h3>
                                            </div>
                                            <div class="card-container" id="completed-orders">
                                                <!-- Listado de pedidos completados -->
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-12 oculto">
                                        <div class="form-group order-category category-3">
                                            <div class="order-header">
                                                <span class="material-symbols-outlined order-icon">arrow_drop_down_circle</span>
                                                <h3 class="order-icon">Envío por Mensajería</h3>
                                            </div>
                                            <div class="card-container" id="courier-orders">
                                                <!-- Listado de pedidos enviados por mensajería -->
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-12 oculto">
                                        <div class="form-group order-category category-4">
                                            <div class="order-header">
                                                <span class="material-symbols-outlined order-icon">arrow_drop_down_circle</span>
                                                <h3 class="order-icon">Envío por Paquetería</h3>
                                            </div>
                                            <div class="card-container" id="parcel-orders">
                                                <!-- Listado de pedidos enviados por paquetería -->
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-12 oculto">
                                        <div class="form-group order-category category-5">
                                            <div class="order-header">
                                                <span class="material-symbols-outlined order-icon">arrow_drop_down_circle</span>
                                                <h3 class="order-icon">Devuelto</h3>
                                            </div>
                                            <div class="card-container" id="returned-orders">
                                                <!-- Listado de pedidos devueltos -->
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-12 oculto">
                                        <div class="form-group order-category category-1">
                                            <div class="order-header">
                                                <span class="material-symbols-outlined order-icon">arrow_drop_down_circle</span>
                                                <h3 class="order-icon">Reprogramado</h3>
                                            </div>
                                            <div class="card-container" id="rescheduled-orders">
                                                <!-- Listado de pedidos Reprogramado -->
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-12 oculto">
                                        <div class="form-group order-category category-2">
                                            <div class="order-header">
                                                <span class="material-symbols-outlined order-icon">arrow_drop_down_circle</span>
                                                <h3 class="order-icon">Recoge en oficina</h3>
                                            </div>
                                            <div class="card-container" id="pickup-orders">
                                                <!-- Listado de pedidos Recoge en oficina -->
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-12 oculto">
                                        <div class="form-group order-category category-6">
                                            <div class="order-header">
                                                <span class="material-symbols-outlined order-icon">arrow_drop_down_circle</span>
                                                <h3 class="order-icon">Anulado</h3>
                                            </div>
                                            <div class="card-container" id="canceled-orders">
                                                <!-- Listado de pedidos anulados -->
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-12 oculto">
                                        <div class="form-group order-category category-7">
                                            <div class="order-header">
                                                <span class="material-symbols-outlined order-icon">arrow_drop_down_circle</span>
                                                <h3 class="order-icon">Entregado</h3>
                                            </div>
                                            <div class="card-container" id="delivered-orders">
                                                <!-- Listado de pedidos entregados -->
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Modal -->
    <div id="order-modal" class="modal fade" tabindex="-1" aria-labelledby="orderModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered" role="document">
                <div class="modal-content modal-custom">
                    <!--Modal header-->
                    <div class="modal-header">
                        <div class="col-12">
                            <div class="form-group d-flex align-items-center mt-2 mb-2">
                                <span class="material-symbols-outlined card-icon">
                                    receipt
                                </span>
                                <h5 class="modal-title" id="orderModalLabel">DETALLE DEL PEDIDO</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">
                                    <span aria-hidden="true">&times;</span>
                                </button>
                            </div>
                        </div>
                    </div>
                    <!--Modal body-->
                    <div class="modal-body">
                        <div id="modal-order-details">
                            <div class="row">
                                <div class="col-6">
                                    <label class="mb-0"><strong>Cliente:</strong></label>
                                    <p class ="mt-0" id="txtInfoCliente"></p>
                                </div>
                                 <div class="col-6">
                                     <label class="mb-0"><strong>Folio:</strong></label>
                                     <p class ="mt-0" id="txtInfoTicket"></p>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-6">
                                    <label class="mb-0"><strong>Fecha del Pedido:</strong></label>
                                    <p class ="mt-0" id="txtInfoFechaPedido"></p>
                                </div>
                                <div class="col-6">
                                    <label class="mb-0"><strong>Total:</strong></label>
                                    <p class="mt-0" id="txtInfoTotalPedido"></p>
                                </div>
                            </div>
                        <div class="row">
                            <div class="col-6">
                                <label class="mb-0"><strong>Usuario a cargo:</strong></label>
                                <p class="mt-0" id="txtInfoUsuarioCargo"></p>
                            </div>
                            <div class="col-6" id="pedido-asociado" style="display: none;">
                                <label class="mb-0"><strong>*Se asoció pedido:</strong></label>
                                <p class="mt-0" id="txtInfoPedidoAsociado"></p>
                            </div>
                        </div>
                            <div class="row">
                                <div class="col-12">
                                    <!-- Botón para mostrar/ocultar -->
                                    <a class="btn btn-sm btn-outline-primary mb-2" data-bs-toggle="collapse" href="#detallePedidoContent" role="button" aria-expanded="false" aria-controls="detallePedidoContent">
                                        Ver artículos del pedido
                                    </a>

                                    <!-- Contenedor colapsable -->
                                    <div class="collapse" id="detallePedidoContent">
                                            <div class="table-responsive">
                                                <table class="table table-sm">
                                                    <thead class="table-light">
                                                        <tr>
                                                            <th class="cantidad-col">Cant.</th>
                                                            <th>Producto</th>
                                                            <th class="text-end">Precio</th>
                                                        </tr>
                                                    </thead>
                                                <tbody id="modalDetallePedido">
                                                        <!-- Los productos se agregarán aquí -->
                                                    </tbody>
                                                </table>
                                            </div>
                                    </div>
                                </div>
                            </div>

                            <hr class="custom-hr">

                            <div class="row">
                                <div class="col-6">
                                    <label class="mb-0"><strong>Estado actual: </strong></label>
                                    <p class ="mt-0" id="txtInfoEstadoActual"></p>
                                </div>
                                <div class="col-6">
                                    <label class="mb-0"><strong>Cambio de estado por:</strong></label>
                                    <p class="mt-0" id="txtInfoEstadoUsuario"></p>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-6">
                                    <label class="mb-0"><strong>Fecha estado:</strong></label>
                                    <p class="mt-0" id="txtInfoEstadoFecha"></p>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-6" id="pilot-cargo" style="display: none;">
                                    <label class="mb-0"><strong>Entrega a cargo de:</strong></label>
                                    <p class="mt-0" id="txtInfoMensajero"></p>
                                </div>
                                <div class="col-6" id="parcel-cargo" style="display: none;">
                                    <label class="mb-0"><strong>Enviado por:</strong></label>
                                    <p class="mt-0" id="txtInfoPaqueteria"></p>
                                </div>
                                <div class="col-6" id="pedidoFpago" style="display: none;">
                                    <label class="mb-0"><strong>Forma de pago:</strong></label>
                                    <p class="mt-0" id="txtInfoFormaPago"></p>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-12">
                                    <div id="detEstado" style="display: none;">
                                        <label class="mb-0"><strong>Detalle de estado:</strong></label>
                                        <p class="mt-0" id="txtInfoDetalleEstado"></p>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <hr class="custom-hr">

                        <div class="row oculto" id="cambiosPedido">
                            <div class="cambiosE"> 
                                <div class="col-12 d-flex align-items-center">
                                    <span class="material-symbols-outlined card-icon">
                                        low_priority
                                    </span>
                                    <h5 class="modal-title" id="orderModalLabel">CAMBIAR ESTADO</h5>
                                </div>
                            </div>
                               
                            <div class="col-12 mb-3">
                                <label><strong>Observaciones de cambio de estado:</strong></label>
                                <textarea class="form-control" id="txtInfoObservaciones"></textarea>
                            </div>
                            <div id="status-change-options" class="d-flex flex-wrap gap-2">
                            </div>
                        </div>
                        <!--Selección de Piloto-->
                        <div class="row">
                            <div class="col-md-12">
                                <div id="pilot-selection" style="display: none;">
                                    <label><strong>Asignar piloto:</strong></label>
                                    <select id="pilot-select" class="form-select mb-2">
                                        <!--lista pilotos-->
                                    </select>
                                <button id="assign-pilot-btn" class="btn btn-primary btn-block my-3" style="display: none;">
                                    <i class="fas fa-sync-alt me-2"></i> Cambiar estado
                                </button>
                                </div>
                            </div>
                        </div>
                        <!--Selección de Paquetería-->
                        <div class="row">
                            <div class="col-md-12">
                                <div id="parcel-selection" style="display: none;">
                                    <label><strong>Asignar paquetería:</strong></label>
                                    <select id="parcel-select" class="form-select mb-2">
                                        <!--Opciones de paquetería-->
                                    </select>
                                    <button id="assign-parcel-btn" class="btn btn-primary btn-block" style="display: none;">
                                        <i class="fas fa-sync-alt me-2"></i> Cambiar estado
                                    </button>
                                </div>
                            </div>
                        </div>
                        <!--Selección de Forma de pago-->
                        <div class="row">
                            <div class="col-md-12">
                                <div id="fpago-selection" style="display: none;">
                                    <label><strong>Forma de pago:</strong></label>
                                    <select id="fpago-select" class="form-select mb-2">
                                        <option value="">Seleccione una opción</option>
                                        <option value="T">Transferencia</option>
                                        <option value="E">Efectivo</option>
                                    </select>
                                    <button id="assign-fpago-btn" class="btn btn-primary btn-block" style="display: none;">
                                        <i class="fas fa-sync-alt me-2"></i> Cambiar estado
                                    </button>
                                </div>
                            </div>
                        </div>
                        </div>
                    </div>
                </div>
            </div>


     
   <!--Dialogo clientes-->
   <div class="modal fade" id="dialogBusquedaClientes" tabindex="-1" aria-labelledby="dlgBCli" aria-hidden="true">
	    <div class="modal-dialog modal-dialog-centered modal-sm">
		    <div class="modal-content">
			    <div class="modal-header">
                    <h5 class="modal-title" id="dlgBCli">Buscar clientes</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
			    </div>
			    <div class="modal-body">
                <input type="text" id="filterInput" class="form-control mb-3" placeholder="Filtrar clientes...">
				    <div id="listaClientes" class="list-group cliente-scroll-container"></div>
			    </div>
			    <div class="modal-footer">
				    <!--mostrar cantidad de clientes-->
			    </div>
		    </div>
	    </div>
    </div>

    <!--Dialogo pedidos encontrados <div class="modal-dialog modal-m modal-dialog-scrollable"> -->
    <div class="modal fade" id="modalPedidos" tabindex="-1" aria-labelledby="modalPedidosLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width: auto; width: auto;">
            <div class="modal-content" style="height: auto;">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalPedidosLabel">Selecciona un pedido...</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body" id="modalPedidosBody">
                    <!-- Aquí se agregará la lista de pedidos encontrados -->
                </div>
            </div>
        </div>
    </div>


    <script type="text/javascript">
        let parametros = "";
        let usuarioLogin = "";
        let pilotosActivos = [];
        let modalInstance;
        
        const categoryMap = {
            "En producción": "production",
            "Envío por Mensajería": "courier",
            "Envío por Paquetería": "parcel",
            "Entregado": "delivered",
            "Devuelto": "returned",
            "Anulado": "canceled",
            "Completado": "completed",
            "Recoge en oficina": "pickup",
            "Reprogramar": "rescheduled"
        };

        const entospa = {
            "production": "En producción",
            "courier": "Envío por Mensajería",
            "parcel": "Envío por Paquetería",
            "delivered": "Entregado",
            "returned": "Devuelto",
            "canceled": "Anulado",
            "completed": "Completado",
            "pickup": "Recoge en oficina",
            "rescheduled": "Reprogramar"

        };

        let dialogBusquedaClientes = document.getElementById('dialogBusquedaClientes');
        let inputFiltro = document.getElementById('filterInput');
        let inputCliente = document.getElementById('txtCliente');
        let focusedIndex = -1;
        let clientes = [];

        $(document).ready(function(){
            $('[data-toggle="tooltip"]').tooltip();

            consultaPedidos();
            cargaClientes();

            // Detectar atajos de teclado
            document.addEventListener("keydown", function(event) {
                if (event.ctrlKey && event.key === "c") {
                    event.preventDefault();
                    document.getElementById("tipoBusqueda").value = "cliente";
                    limpiar();
                    mostrarCampos();
                }
                if (event.ctrlKey && event.key === "f") {
                    event.preventDefault();
                    document.getElementById("tipoBusqueda").value = "folio";
                    limpiar();
                    mostrarCampos();
                }
                if (event.ctrlKey && event.key === "l") {
                    event.preventDefault();
                    limpiar();
                }
                if (event.ctrlKey && event.key === "a") {
                    event.preventDefault();
                    $('#dialogBusquedaClientes').modal('show');
                    actualizarLista('');
                }
                if (event.key === "Enter") {
                    event.preventDefault(); 
                    let tipoBusqueda = $("#tipoBusqueda").val();
                    if (tipoBusqueda === "folio") {
                        buscarTicketFolio();
                    } else {
                        buscarTicketCliente();
                    }

            });

            inputFiltro.addEventListener('input', e => {
              actualizarLista(e.target.value);
            });

            inputFiltro.addEventListener('keydown', e => {
                const lista = document.getElementById('listaClientes');
                const items = lista.querySelectorAll('.cliente-item');
                if (e.key === 'ArrowDown') {
                    e.preventDefault();
                    if (focusedIndex < items.length - 1) {
                        focusedIndex++;
                        updateFocus(items);
                    }
                } else if (e.key === 'ArrowUp') {
                    e.preventDefault();
                    if (focusedIndex > 0) {
                        focusedIndex--;
                        updateFocus(items);
                    }
                } else if (e.key === 'Enter') {
                    e.preventDefault();
                    if (focusedIndex >= 0) {
                        items[focusedIndex].click();
                    }

                }
            });

            function updateFocus(items) {
                items.forEach(item => item.classList.remove('focused'));
                if (focusedIndex >= 0 && focusedIndex < items.length) {
                    items[focusedIndex].classList.add('focused');
                    items[focusedIndex].scrollIntoView({ block: 'nearest' });
                }
            }

            function cargaClientes(){
                $("#btnMostrarClientes i").removeClass('fas fa-users').addClass('fas fa-spinner fa-spin');

                $.ajax({
                    url: '@Url.Action("ObtenerClientes", "Principal")',
                    type: "POST",
                    success: function (data) {
                        const btnMostrarClientes = document.getElementById("btnMostrarClientes");
                        const btnReintentar = document.getElementById("btnReintentarCarga");
                        if (data.existeError) {
                            dialogoEG({
                                type: "error",
                                title: "Error al cargar clientes",
                                mensaje: data.mensajeError,
                                confirmar: "Aceptar",
                                img: "img/error.png"
                            }).then(() => {
                                btnMostrarClientes.setAttribute("disabled", true);
                                btnReintentar.removeAttribute("disabled");
                                btnReintentar.classList.remove("d-none");
                                 $("#btnMostrarClientes i").removeClass('fas fa-spinner fa-spin').addClass('fas fa-users');
                            });
                        } else {
                            if (data.existenDatos) {
                                clientes = data?.infoClientes?.listaClientes || [];
                                 
                                actualizarLista('');

                                btnMostrarClientes.removeAttribute("disabled");
                                btnReintentar.setAttribute("disabled", true);
                                btnReintentar.classList.add("d-none");
                            } else {
                                btnMostrarClientes.setAttribute("disabled", true);
                                btnReintentar.removeAttribute("disabled");
                                btnReintentar.classList.remove("d-none");
                            }
                            $("#btnMostrarClientes i").removeClass('fas fa-spinner fa-spin').addClass('fas fa-users');
                        }
                    },
                    error: function () {
                        console.log("Error en la petición AJAX.");
                        document.getElementById("btnReintentarCarga").removeAttribute("disabled");
                    }
                });
            }


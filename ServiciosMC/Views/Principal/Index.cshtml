                            { state: 'canceled', label: 'Anulado' }
                        ]
                    };
                    // Usar el mapeo para convertir currentState a su correspondiente en inglés
                    const mappedState = categoryMap[currentState];
                    return stateTransitions[mappedState] || [];
                }

